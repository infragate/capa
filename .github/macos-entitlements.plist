<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Bun's JIT needs allow-jit and allow-unsigned-executable-memory. The embedded
  @napi-rs/keyring addon is extracted and loaded at runtime and isn't signed by
  our team, so library validation stays off. DYLD environment variables are
  deliberately not allowed: that would let any local process inject code into
  the binary the Keychain trusts.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
